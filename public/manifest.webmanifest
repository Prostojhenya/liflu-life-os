{
  "name": "Liflu - Life OS",
  "short_name": "Liflu",
  "description": "Ваша операционная система для жизни",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#0b0416",
  "theme_color": "#0b0416",
  "orientation": "portrait-primary",
  "scope": "/",
  "icons": [
    {
      "src": "/img/liflu-icon.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/img/liflu-icon.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "categories": ["productivity", "lifestyle"],
  "prefer_related_applications": false,
  "shortcuts": [
    {
      "name": "Задачи",
      "short_name": "Задачи",
      "description": "Открыть список задач",
      "url": "/?view=tasks",
      "icons": [{ "src": "/img/liflu-icon.png", "sizes": "192x192" }]
    },
    {
      "name": "Привычки",
      "short_name": "Привычки",
      "description": "Открыть привычки",
      "url": "/?view=habits",
      "icons": [{ "src": "/img/liflu-icon.png", "sizes": "192x192" }]
    }
  ],
  "screenshots": [],
  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  }
}
