rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function isMember(spaceId) {
      return isSignedIn() && exists(/databases/$(database)/documents/spaces/$(spaceId)/members/$(uid()));
    }

    function isNotificationForSpaceMember(userId) {
      let spaceId = request.resource.data.data.spaceId;
      return isSignedIn()
        && spaceId is string
        && isMember(spaceId)
        && exists(/databases/$(database)/documents/spaces/$(spaceId)/members/$(userId))
        && request.resource.data.keys().hasOnly(['title', 'body', 'type', 'read', 'createdAt', 'data'])
        && request.resource.data.title is string
        && request.resource.data.body is string
        && request.resource.data.type in ['task_reminder', 'habit_reminder', 'achievement', 'streak', 'system']
        && request.resource.data.read == false;
    }

    function isMessageNotification(userId) {
      return isSignedIn()
        && request.resource.data.type == 'message'
        && request.resource.data.read == false
        && 'data' in request.resource.data
        && 'conversationId' in request.resource.data.data
        && request.resource.data.data.conversationId is string
        && exists(/databases/$(database)/documents/conversations/$(request.resource.data.data.conversationId))
        && get(/databases/$(database)/documents/conversations/$(request.resource.data.data.conversationId)).data.participants.hasAny([uid(), userId]);
    }

    // ===============================================================
    // Users
    // ===============================================================
    match /users/{userId} {
      allow read: if isSignedIn() && uid() == userId;
      allow create: if isSignedIn() && uid() == userId;
      allow update: if isSignedIn() && uid() == userId;
    }

    // ===============================================================
    // Spaces (FINAL - with memberIds requirement)
    // ===============================================================
    match /spaces/{spaceId} {
      allow get:    if isSignedIn() && (resource.data.ownerId == uid() || isMember(spaceId));
      allow list:   if isSignedIn() && request.query.limit != null && 
                       ('memberIds' in resource.data && resource.data.memberIds.hasAny([uid()]));
      allow create: if isSignedIn() && request.resource.data.ownerId == uid() &&
                       request.resource.data.memberIds is list &&
                       request.resource.data.memberIds.hasAny([uid()]);
      allow update: if isSignedIn() && resource.data.ownerId == uid();
      allow delete: if isSignedIn() && resource.data.ownerId == uid();

      match /members/{memberId} {
        allow read:   if isSignedIn() && (isMember(spaceId) || get(/databases/$(database)/documents/spaces/$(spaceId)).data.ownerId == uid());
        allow create: if isSignedIn() && (
          get(/databases/$(database)/documents/spaces/$(spaceId)).data.ownerId == uid() ||
          (memberId == uid() && request.resource.data.userId == uid())
        );
        allow update: if isSignedIn() && get(/databases/$(database)/documents/spaces/$(spaceId)).data.ownerId == uid();
        allow delete: if isSignedIn() && (
          memberId == uid() ||
          get(/databases/$(database)/documents/spaces/$(spaceId)).data.ownerId == uid()
        );
      }

      match /tasks/{taskId} {
        allow read:   if isMember(spaceId);
        allow create: if isMember(spaceId);
        allow update: if isMember(spaceId);
        allow delete: if isMember(spaceId);
      }

      match /habits/{habitId} {
        allow read:   if isMember(spaceId);
        allow create: if isMember(spaceId);
        allow update: if isMember(spaceId);
        allow delete: if isMember(spaceId);

        match /completions/{completionId} {
          allow read:   if isMember(spaceId);
          allow create: if isMember(spaceId) && request.resource.data.userId == uid();
          allow update: if isMember(spaceId) && resource.data.userId == uid();
          allow delete: if isMember(spaceId);
        }
      }

      match /shopping/{itemId} {
        allow read:   if isMember(spaceId);
        allow create: if isMember(spaceId);
        allow update: if isMember(spaceId);
        allow delete: if isMember(spaceId);
      }

      match /goals/{goalId} {
        allow read:   if isMember(spaceId);
        allow create: if isMember(spaceId);
        allow update: if isMember(spaceId);
        allow delete: if isMember(spaceId);
      }

      match /messages/{messageId} {
        allow read:   if isMember(spaceId);
        allow create: if isMember(spaceId);
        allow update: if isMember(spaceId);
        allow delete: if isMember(spaceId);
      }
    }

    // ===============================================================
    // Conversations (direct & group chats)
    // ===============================================================
    match /conversations/{convId} {
      allow read: if isSignedIn() && resource.data.participants.hasAny([uid()]);
      allow list: if isSignedIn() && request.query.limit != null &&
                     ('participants' in resource.data && resource.data.participants.hasAny([uid()]));
      allow create: if isSignedIn() && request.resource.data.participants.hasAny([uid()]);
      allow update: if isSignedIn() && resource.data.participants.hasAny([uid()]);

      match /messages/{msgId} {
        allow read:   if isSignedIn() && get(/databases/$(database)/documents/conversations/$(convId)).data.participants.hasAny([uid()]);
        allow create: if isSignedIn() && get(/databases/$(database)/documents/conversations/$(convId)).data.participants.hasAny([uid()]);
        allow update: if isSignedIn() && resource.data.senderId == uid();
        allow delete: if isSignedIn() && resource.data.senderId == uid();
      }
    }

    // ===============================================================
    // Notifications
    // ===============================================================
    match /users/{userId}/notifications/{notificationId} {
      allow read:   if isSignedIn() && userId == uid();
      allow create: if isSignedIn() && (
        userId == uid() ||
        isNotificationForSpaceMember(userId) ||
        isMessageNotification(userId)
      );
      allow update: if isSignedIn() && userId == uid();
      allow delete: if isSignedIn() && userId == uid();
    }

    // ===============================================================
    // Scheduled Notifications
    // ===============================================================
    match /users/{userId}/scheduledNotifications/{notificationId} {
      allow read:   if isSignedIn() && userId == uid();
      allow create: if isSignedIn() && userId == uid();
      allow update: if isSignedIn() && userId == uid();
      allow delete: if isSignedIn() && userId == uid();
    }

    // ===============================================================
    // Invite Links
    // ===============================================================
    match /inviteLinks/{tokenId} {
      allow get:    if isSignedIn();
      allow list:   if false; // No listing - only get by known token
      allow create: if isSignedIn() && request.resource.data.createdBy == uid();
      allow update: if isSignedIn() && 
                       resource.data.used == false &&
                       request.resource.data.used == true &&
                       request.resource.data.usedBy == uid() &&
                       request.resource.data.spaceId == resource.data.spaceId &&
                       request.resource.data.keys().hasOnly(['used', 'usedBy']);
    }

    // ===============================================================
    // Invites
    // ===============================================================
    match /invites/{inviteId} {
      allow get:    if isSignedIn() && (
                       resource.data.email == request.auth.token.email ||
                       resource.data.invitedBy == uid()
                    );
      allow list:   if isSignedIn() && request.query.limit != null && (
                       ('email' in request.query && request.query.email == request.auth.token.email) ||
                       ('invitedBy' in request.query && request.query.invitedBy == uid())
                    );
      allow create: if isSignedIn() && request.resource.data.invitedBy == uid();
      allow update: if isSignedIn() && (
        resource.data.email == request.auth.token.email ||
        resource.data.invitedBy == uid()
      );
      allow delete: if isSignedIn() && resource.data.invitedBy == uid();
    }
  }
}
